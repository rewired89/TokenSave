{
  "manifest_version": 3,
  "name": "Save Tokens — live input distiller",
  "version": "0.1.0",
  "description": "After 5s of typing inactivity, distills your draft into a shorter prompt that preserves all requirements. Shows a diff before you hit Enter.",
  "browser_specific_settings": {
    "gecko": {
      "id": "save-tokens@tokensave.local",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "permissions": [],
  "host_permissions": ["https://claude.ai/*"],
  "content_scripts": [
    {
      "matches": ["https://claude.ai/*"],
      "js": ["compress.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
